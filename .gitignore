# ============================================================
# FormIQ - Git Ignore
# Prevents secrets, credentials, virtual environments,
# generated files and local development artifacts from
# being committed to GitHub.
# ============================================================

# -----------------------------
# Python
# -----------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd

# -----------------------------
# Virtual environments
# -----------------------------
venv/
.venv/
env/
ENV/

# -----------------------------
# Environment variables / secrets
# -----------------------------
.env
.env.*
!.env.example

# -----------------------------
# Google OAuth credentials
# -----------------------------
credentials.json
token.json
client_secret*.json

# -----------------------------
# API / authentication secrets
# -----------------------------
*.pem
*.key
*.crt
secrets.json

# -----------------------------
# Uploads / generated files
# -----------------------------
uploads/*
!uploads/.gitkeep

backend/uploads/*
!backend/uploads/.gitkeep

# -----------------------------
# Logs
# -----------------------------
*.log
logs/

# -----------------------------
# Testing / coverage
# -----------------------------
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# -----------------------------
# IDE
# -----------------------------
.vscode/
.idea/

# -----------------------------
# OS files
# -----------------------------
.DS_Store
Thumbs.db
desktop.ini

# -----------------------------
# Node / React
# -----------------------------
node_modules/
dist/
build/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------------------
# Temporary files
# -----------------------------
*.tmp
*.temp
*.bak
*.swp

# -----------------------------
# Jupyter
# -----------------------------
.ipynb_checkpoints/

# -----------------------------
# Local databases
# -----------------------------
*.db
*.sqlite
*.sqlite3